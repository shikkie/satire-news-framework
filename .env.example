# Agent News application stack — copy to .env and adjust.
# Local: agentnews.local + assets.agentnews.local (Pi-hole / lab DNS)
# Prod:  agentnews.site  + assets.agentnews.site  on DO droplet + Spaces + Gcore

# --- Site identity ---
SITE_DOMAIN=agentnews.local
ASSETS_DOMAIN=assets.agentnews.local
SITE_NAME=Agent News
SITE_URL=http://agentnews.local
ASSETS_URL=http://assets.agentnews.local

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins allowed for CORS (empty = same-origin only)
CORS_ORIGINS=

# --- Bootstrap admin (created on first boot if no users exist) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=agentnews

# --- S3 / MinIO (local) or DigitalOcean Spaces (prod) ---
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://assets.agentnews.local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agentnews-media
S3_REGION=us-east-1
# Set true for path-style MinIO; false for Spaces virtual-host style
S3_FORCE_PATH_STYLE=true
# Public base URL for object links written into Mongo (no trailing slash)
MEDIA_PUBLIC_BASE_URL=http://assets.agentnews.local/agentnews-media

# --- Session ---
SESSION_IDLE_MINUTES=15
SESSION_HEADER=X-Session-Id

# --- Gcore CDN (main site purge/prime). Leave empty to stub/log only. ---
GCORE_API_TOKEN=
GCORE_RESOURCE_ID=
GCORE_CDN_BASE_URL=

# --- Spaces CDN prime (optional; HEAD/GET prime of media URLs) ---
SPACES_CDN_PRIME=true

# --- Nginx / compose ---
COMPOSE_PROJECT_NAME=agentnews
# Host ports. This lab already uses 80 (aispotr) and 8000 (other API).
NGINX_HTTP_PORT=80
API_PUBLISH_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
